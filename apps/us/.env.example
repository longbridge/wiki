# 复制此文件为 .env.local 并填入真实值（.env.local 已在 .gitignore 中忽略）

# AI 智能问答接口配置
VITE_AI_API_HOST=https://your-api-host.example.com
VITE_AI_API_ENDPOINT=/api/forward/v1/customer-service/docs/chat

# Zendesk 同步 (bun run sync:us) —— 只有 ZENDESK_SUBDOMAIN 必填。
# EMAIL / API_TOKEN 可选:填写则带 Basic Auth,留空则匿名读取已发布内容。
# CI (deploy.yml) 默认走匿名,不配这两个 Secret;若匿名被 Cloudflare 拦截,
# 再在 repo Secrets 配 ZENDESK_EMAIL / ZENDESK_API_TOKEN 并给 sync 步骤加 env。
ZENDESK_SUBDOMAIN=longbridgeus
# ZENDESK_EMAIL=you@longbridge-inc.com
# ZENDESK_API_TOKEN=your-zendesk-api-token
