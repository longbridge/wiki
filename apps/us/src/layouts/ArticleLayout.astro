---
import BaseLayout from './BaseLayout.astro'
import SideTree from '../components/SideTree.astro'
import Footer from '../components/Footer.astro'
import { getNav } from '../lib/nav'
import { withBase } from '../lib/paths'
import type { CollectionEntry } from 'astro:content'
import '../styles/article.css'

interface Props {
  entry: CollectionEntry<'docs'>
  headings?: { depth: number; slug: string; text: string }[]
}

const { entry } = Astro.props

const nav = await getNav()

// ── Breadcrumb resolution ──────────────────────────────────────────────────
const segs = entry.id.split('/')
// segs[0] = catSlug, segs[1] = secSlug, segs[2] = articleSlug (for articles)
const catSlug = segs[0] ?? ''
const secSlug = segs[1] ?? ''

const cat = nav.find((c) => c.slug === catSlug)
const sec = cat?.sections.find((s) => s.slug === secSlug)

// ── Related articles (same section, exclude self, max 4) ───────────────────
const selfSlug = segs[segs.length - 1] ?? ''
const related = sec?.articles.filter((a) => a.slug !== selfSlug).slice(0, 4) ?? []

// ── GitHub edit link ───────────────────────────────────────────────────────
const editHref = `https://github.com/longbridge/docs/edit/main/apps/us/docs/en/${entry.id}.md`

// ── currentPath for SideTree (needs /us prefix) ───────────────────────────
const currentPath = withBase('/' + entry.id)

// ── zendesk_article_id — only render votes if set ─────────────────────────
const zendeskId = entry.data.zendesk_article_id
---

<BaseLayout title={entry.data.title} hideFooter={true}>
  <div class="article-page">
    <!-- Col 1: aside / side-tree -->
    <aside class="article-page__aside" aria-label="Section navigation">
      <SideTree nav={nav} currentPath={currentPath} />
    </aside>

    <!-- Col 2 row 1: main article content -->
    <main class="article-page__main" id="main-content">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb">
        <ol class="article-breadcrumb">
          <li><a href={withBase('/')}>Home</a></li>
          {cat && (
            <li>
              <a href={withBase(cat.firstArticlePath)}>{cat.title}</a>
            </li>
          )}
          {sec && (
            <li>
              <a href={withBase(sec.firstArticlePath)}>{sec.title}</a>
            </li>
          )}
          <li aria-current="page">{entry.data.title}</li>
        </ol>
      </nav>

      <!-- Article heading -->
      <h1 class="article-title">{entry.data.title}</h1>

      <!-- Article body (rendered markdown) -->
      <div class="article-body">
        <slot />
      </div>

      <!-- Hidden metadata for article.ts to read -->
      <div
        data-article-path={currentPath}
        data-article-title={entry.data.title}
        hidden
      />

      <!-- Votes (only when zendesk_article_id is set) -->
      {zendeskId !== undefined && (
        <div class="article-votes" data-article-id={String(zendeskId)}>
          <h2 class="article-votes__question" id="article-votes-label">
            Was this article helpful?
          </h2>
          <div class="article-votes__controls" role="group" aria-labelledby="article-votes-label">
            <button
              type="button"
              class="btn-vote"
              data-vote="up"
              aria-pressed="false"
            >
              Yes
            </button>
            <button
              type="button"
              class="btn-vote"
              data-vote="down"
              aria-pressed="false"
            >
              No
            </button>
          </div>
        </div>
      )}

      <!-- Related articles (build-time) -->
      {related.length > 0 && (
        <section class="article-related" aria-label="Related articles">
          <h2 class="article-related__title">Related Articles</h2>
          <ul>
            {related.map((a) => (
              <li>
                <a href={withBase(a.path)}>{a.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Recently viewed (client-rendered by article.ts) -->
      <section class="article-recent" aria-label="Recently viewed">
        <h2 class="article-recent__title">Recently Viewed</h2>
        <ul></ul>
      </section>

      <!-- GitHub edit link -->
      <p class="article-edit">
        <a href={editHref} target="_blank" rel="noopener noreferrer">
          Edit this article on GitHub
        </a>
      </p>
    </main>

    <!-- Col 2 row 2: footer auto-placed by grid -->
    <Footer />
  </div>
</BaseLayout>

<script>
  import '../scripts/article.ts'
</script>
