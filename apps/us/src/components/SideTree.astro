---
import type { NavCategory } from '../lib/nav-core'
import { withBase } from '../lib/paths'
import { CAT_ICONS, iconKeyForSlug } from '../lib/cat-icons'

interface Props {
  nav: NavCategory[]
  currentPath: string
}

const { nav, currentPath } = Astro.props

// Normalize for comparison: strip trailing slash (keep bare '/')
function normPath(p: string) {
  return p.length > 1 ? p.replace(/\/$/, '') : p
}

const norm = normPath(currentPath)

const CHEVRON_SVG = `<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6l4 4 4-4"/></svg>`
---

<ul class="side-tree__list" role="list">
  {nav.map((cat) => {
    // Determine which sections contain the current article
    const openSecs = new Set(
      cat.sections
        .filter((sec) => sec.articles.some((a) => normPath(withBase(a.path)) === norm))
        .map((sec) => sec.slug)
    )
    const catIsOpen = openSecs.size > 0

    return (
      <li class:list={['side-tree__cat', catIsOpen && 'is-open']}>
        <div class="side-tree__cat-head">
          <a class="side-tree__cat-link" href={withBase(cat.firstArticlePath)}>
            <span class="side-tree__cat-icon" aria-hidden="true" set:html={CAT_ICONS[iconKeyForSlug(cat.slug)]} />
            <span class="side-tree__cat-label">{cat.title}</span>
          </a>
          <button
            class="side-tree__chevron-btn"
            type="button"
            aria-expanded={catIsOpen ? 'true' : 'false'}
            aria-label="Toggle category"
            set:html={CHEVRON_SVG}
          />
        </div>
        <ul class="side-tree__cat-body" role="list">
          {cat.sections.map((sec) => {
            const secIsOpen = openSecs.has(sec.slug)
            return (
              <li class:list={['side-tree__sec', secIsOpen && 'is-open']}>
                <div class="side-tree__sec-head">
                  <a class="side-tree__sec-link" href={withBase(sec.firstArticlePath)}>
                    <span class="side-tree__sec-label">{sec.title}</span>
                  </a>
                  <button
                    class="side-tree__chevron-btn"
                    type="button"
                    aria-expanded={secIsOpen ? 'true' : 'false'}
                    aria-label="Toggle section"
                    set:html={CHEVRON_SVG}
                  />
                </div>
                <ul class="side-tree__sec-body" role="list">
                  {sec.articles.map((article) => {
                    const isCurrent = normPath(withBase(article.path)) === norm
                    return (
                      <li>
                        <a
                          href={withBase(article.path)}
                          class:list={['side-tree__item', isCurrent && 'is-current']}
                          aria-current={isCurrent ? 'page' : undefined}
                        >
                          {article.title}
                        </a>
                      </li>
                    )
                  })}
                </ul>
              </li>
            )
          })}
        </ul>
      </li>
    )
  })}
</ul>
