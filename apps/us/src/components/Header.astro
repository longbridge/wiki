---
import { getNav } from '../lib/nav'
import { withBase } from '../lib/paths'
import { CAT_ICONS, iconKeyForSlug } from '../lib/cat-icons'

interface Props {
  // intentionally empty – isHome removed; transparent state is JS/hero-driven
}

const {} = Astro.props
const nav = await getNav()

// Logo URLs
const LOGO_URL = 'https://assets.lbkrs.com/uploads/133373dd-3296-44d9-8d5a-3ad7d0c1f2e3/logo.png'
const LOGO_LIGHT_URL = 'https://assets.lbkrs.com/uploads/f6e3a8fd-c43b-471a-99b2-650ae061e2e8/logo_light.png'
const LOGO_DARK_URL = 'https://assets.lbkrs.com/uploads/8d92f710-23cf-4c62-a800-d2928c216c75/logo_dark.png'
---

<header
  class="lb-header"
  id="lb-header"
>
  <div class="lb-header__inner">
    <!-- Logo -->
    <a href={withBase('/')} class="lb-header__logo" aria-label="Longbridge Help Center home">
      <!-- Default logo (light bg) -->
      <img
        src={LOGO_URL}
        alt="Longbridge"
        class="lb-logo lb-logo--default"
        width="140"
        height="36"
        loading="eager"
      />
      <!-- Light logo (transparent / dark bg) -->
      <img
        src={LOGO_LIGHT_URL}
        alt="Longbridge"
        class="lb-logo lb-logo--light"
        width="140"
        height="36"
        loading="eager"
      />
      <!-- Dark mode logo -->
      <img
        src={LOGO_DARK_URL}
        alt="Longbridge"
        class="lb-logo lb-logo--dark"
        width="140"
        height="36"
        loading="eager"
      />
    </a>

    <!-- Desktop nav -->
    <nav class="lb-topnav" aria-label="Main navigation">
      <a href={withBase('/')} class="lb-topnav__link">Home</a>

      <!-- All Topics mega dropdown -->
      <div class="lb-topnav__dropdown" data-lb-dropdown>
        <button
          class="lb-topnav__link lb-topnav__trigger"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="lb-mega-menu"
          data-lb-dropdown-trigger
        >
          All Topics
          <svg class="lb-topnav__chevron" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M4 6l4 4 4-4"/>
          </svg>
        </button>

        <!-- Mega menu panel -->
        <div class="lb-mega" id="lb-mega-menu" hidden aria-label="All Topics">
          <!-- Left: category list -->
          <ul class="lb-mega__cats" role="list">
            {nav.map((cat, idx) => (
              <li
                class="lb-mega__cat-item"
                data-cat={cat.slug}
                data-lb-cat-item
              >
                <button
                  class={`lb-mega__cat-btn${idx === 0 ? ' is-active' : ''}`}
                  aria-expanded={idx === 0 ? 'true' : 'false'}
                  data-cat={cat.slug}
                  data-lb-cat-btn
                >
                  <span class="lb-mega__cat-icon" aria-hidden="true" set:html={CAT_ICONS[iconKeyForSlug(cat.slug)]} />
                  <span class="lb-mega__cat-name">{cat.title}</span>
                  <span class="lb-mega__cat-count">
                    {cat.sections.reduce((n, s) => n + s.articles.length, 0)} articles
                  </span>
                </button>
              </li>
            ))}
          </ul>

          <!-- Right: per-category panels -->
          <div class="lb-mega__panels">
            {nav.map((cat, idx) => (
              <div
                class={`lb-mega__panel${idx === 0 ? ' is-active' : ''}`}
                id={`lb-mega-panel-${cat.slug}`}
                data-cat={cat.slug}
                hidden={idx !== 0}
                aria-label={cat.title}
              >
                {cat.sections.map((sec) => (
                  <div class="lb-mega__section">
                    <h3 class="lb-mega__section-title">{sec.title}</h3>
                    <ul class="lb-mega__article-list" role="list">
                      {sec.articles.slice(0, 5).map((art) => (
                        <li>
                          <a href={withBase(art.path)} class="lb-mega__article-link">
                            {art.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
                <a href={withBase(cat.firstArticlePath)} class="lb-mega__view-all">
                  View all in {cat.title}
                  <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M6 4l4 4-4 4"/>
                  </svg>
                </a>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Search trigger -->
      <button class="lb-header-search-btn lb-topnav__link" aria-label="Open search" aria-haspopup="dialog" data-lb-search-open>
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.5"/>
          <path d="M15 15l3 3"/>
        </svg>
        <span class="lb-topnav__search-label">Search</span>
      </button>
    </nav>

    <!-- Right actions -->
    <div class="lb-header__actions">
      <!-- Region switch -->
      <div class="lb-region" data-lb-region>
        <button
          class="lb-region__trigger"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="lb-region-menu"
          data-lb-region-trigger
          aria-label="Select region"
        >
          <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="10" cy="10" r="8"/>
            <path d="M2 10h16M10 2a15 15 0 0 1 0 16M10 2a15 15 0 0 0 0 16"/>
          </svg>
          <span class="lb-region__label">US</span>
          <svg class="lb-region__chevron" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M4 6l4 4 4-4"/>
          </svg>
        </button>

        <ul class="lb-region__menu" id="lb-region-menu" hidden role="menu" aria-label="Select region">
          <li role="none">
            <button class="lb-region__option" role="menuitem" data-region-code="us" data-lb-region-option>
              <span class="lb-region__flag">🇺🇸</span>
              United States
            </button>
          </li>
          <li role="none">
            <button class="lb-region__option" role="menuitem" data-region-code="hk" data-lb-region-option>
              <span class="lb-region__flag">🇭🇰</span>
              Hong Kong
            </button>
          </li>
          <li role="none">
            <button class="lb-region__option" role="menuitem" data-region-code="sg" data-lb-region-option>
              <span class="lb-region__flag">🇸🇬</span>
              Singapore
            </button>
          </li>
        </ul>
      </div>

      <!-- Theme toggle -->
      <button
        class="lb-theme-toggle"
        aria-label="Toggle dark/light mode"
        data-lb-theme-toggle
        type="button"
      >
        <!-- Sun icon — visible in dark mode -->
        <svg class="lb-theme-icon lb-theme-icon--sun" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <circle cx="10" cy="10" r="4"/>
          <path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M4.2 15.8l1.4-1.4M14.4 5.6l1.4-1.4"/>
        </svg>
        <!-- Moon icon — visible in light mode -->
        <svg class="lb-theme-icon lb-theme-icon--moon" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <path d="M17.5 11.5A7.5 7.5 0 0 1 8.5 2.5a7.5 7.5 0 1 0 9 9z"/>
        </svg>
      </button>

      <!-- GitHub link -->
      <a
        href="https://github.com/longbridge/docs"
        class="lb-header__github"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Longbridge on GitHub"
      >
        <svg viewBox="0 0 20 20" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M10 0C4.477 0 0 4.477 0 10c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.483 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.34-3.369-1.34-.454-1.155-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 10 4.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.741 0 .269.18.579.688.481C17.137 18.163 20 14.418 20 10c0-5.523-4.477-10-10-10z"/>
        </svg>
      </a>

      <!-- Mobile: search + hamburger -->
      <button class="lb-header-search-btn lb-header__mobile-search" aria-label="Open search" data-lb-search-open>
        <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.5"/>
          <path d="M15 15l3 3"/>
        </svg>
      </button>

      <button
        class="lb-hamburger"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="lb-cat-drawer"
        data-lb-cat-drawer-open
        type="button"
      >
        <svg class="lb-hamburger__icon lb-hamburger__icon--open" viewBox="0 0 20 20" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14"/>
        </svg>
        <svg class="lb-hamburger__icon lb-hamburger__icon--close is-hidden" viewBox="0 0 20 20" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <path d="M5 5l10 10M15 5L5 15"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  import '../scripts/header.ts'
</script>
